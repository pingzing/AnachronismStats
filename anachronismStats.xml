<Ui xmlns="http://www.blizzard.com/wow/ui/"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Include file="templates.xml" />
  <Script file="anachronismStats.lua" />

  <!-- Button to show/hide AS Stats panel -->
  <Button name="AnachronismStats_OpenStats" inherits="UIPanelSquareButton" motionScriptsWhileDisabled="false" parent="PaperDollItemsFrame">
    <Anchors>
      <Anchor point="TOPLEFT" relativeTo="PaperDollItemsFrame" relativePoint="TOPLEFT">
        <Offset x="317" y="-404" />
      </Anchor>
    </Anchors>
    <Scripts>
      <OnClick function="AnachronismStats_OpenStats_OnClick" />
      <OnEnter>
        GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
        GameTooltip:SetText("Anachronism Stats", 1.0,1.0,1.0 );
        GameTooltip:AddLine("View all your stats in a single, scrollable panel.", NORMAL_FONT_COLOR.r, NORMAL_FONT_COLOR.g, NORMAL_FONT_COLOR.b);
        GameTooltip:Show();
      </OnEnter>
      <OnClick function="AnachronismStats_OpenStats_OnClick" />
      <OnLeave function="GameTooltip_Hide" />
      <OnLoad function="AnachronismStats_OpenStats_OnLoad" />
      <OnHide function="AnachronismStats_OpenStats_OnHide" />
    </Scripts>
  </Button>

  <!-- Root frame -->
  <Frame name="AnachronismStats_RootFrame" setAllPoints="true" enableMouse="true" parent="PaperDollFrame" useParentLevel="true">
    <Scripts>
      <OnLoad function="AnachronismStats_Frame_OnLoad" />
      <OnEvent function="AnachronismStats_Frame_OnEvent" />
    </Scripts>
    <Size x="165" y="435" />
    <Anchors>
      <Anchor point="TOPLEFT" relativeTo="PaperDollFrame" relativePoint="TOPRIGHT">
        <Offset x="-38" y="-8" />
      </Anchor>
    </Anchors>
    <Scripts>
    </Scripts>

    <Frames>
      <!-- Frame that draws borders and backgrounds, etc. -->
      <Frame name="AnachronismStats_BackgroundFrame" inherits="DialogBorderTemplate"/>

      <!-- Scroll wrapper around the content -->
      <ScrollFrame name="AnachronismStats_ScrollFrame" inherits="UIPanelScrollFrameTemplate">
        <Size x="123" y="411"/>
        <Anchors>
          <Anchor point="TOPLEFT" x="8" y="-13"/>
        </Anchors>
        <Scripts>
          <OnMouseWheel function="AnachronismStats_Frame_OnMouseWheel" />
        </Scripts>
        <ScrollChild>
          <!-- Frame that actual stat panels attach to. Does not actually wrap them, just
          gives them a parent that lives inside the ScrollChild. -->
          <Frame name="AnachronismStats_ContentAnchor">
            <Size x="1" y="1" />
            <Anchors>
              <Anchor point="TOPLEFT" x="0" y="0" />
            </Anchors>

            <!-- All child frames are parented to this frame in their own Lua OnLoad functions. -->

          </Frame>
        </ScrollChild>

      </ScrollFrame>

    </Frames>

  </Frame>
</Ui>